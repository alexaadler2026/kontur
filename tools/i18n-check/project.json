{
  "name": "i18n-check",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/i18n-check/src",
  "tags": ["scope:shared", "type:util", "platform:server"],
  "targets": {
    "test": {
      "command": "vitest run",
      "options": { "cwd": "tools/i18n-check" },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/*/public/i18n/**/*.json",
        "{workspaceRoot}/apps/*/src/i18n/**/*.json"
      ]
    },
    "typecheck": {
      "command": "tsc -p tools/i18n-check/tsconfig.json",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json"]
    }
  }
}
