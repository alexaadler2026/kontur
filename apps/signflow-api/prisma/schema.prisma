// Database schema of signflow-api (Prisma 7). Changing it needs a migration in the same
// commit: `pnpm nx run signflow-api:prisma-migrate-dev --name=<what>` (Docker running).
// CI checks that schema and migrations match (prisma migrate diff).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in (ADR-0010). Admin flag: task 9.
model User {
  /// UUIDv7 generated by PostgreSQL 18 (ADR-0008).
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Unique regardless of case (citext); stored as typed.
  email        String    @unique @db.Citext
  /// Argon2id PHC string. Null until the password is set (invitation, task 10).
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

/// A signed-in browser (ADR-0010). The cookie holds a random token; this row holds only its
/// SHA-256. Signing out deletes the row; deleting the user deletes their sessions.
model Session {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// SHA-256 of the cookie token, hex. Never the token itself.
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Last request with this session: ends after SESSION_IDLE_DAYS without activity.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute end: SESSION_ABSOLUTE_DAYS after sign-in, however active.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  ip         String?

  @@index([userId])
  @@map("sessions")
}
