{
  "name": "signflow-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/signflow-api/src",
  "projectType": "application",
  "tags": ["scope:signflow", "type:app", "platform:server"],
  "implicitDependencies": ["signflow-api-contract"],
  "targets": {
    "prisma-generate": {
      "command": "prisma generate",
      "options": {
        "cwd": "apps/signflow-api"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma.config.ts"
      ],
      "outputs": ["{projectRoot}/src/generated/prisma"]
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/signflow-api",
        "main": "apps/signflow-api/src/main.ts",
        "tsConfig": "apps/signflow-api/tsconfig.app.json",
        "generatePackageJson": true,
        "transformers": [
          {
            "name": "@nestjs/swagger/plugin",
            "options": {
              "introspectComments": true
            }
          }
        ],
        "assets": [
          {
            "input": "apps/signflow-api/prisma/migrations",
            "glob": "**/*",
            "output": "prisma/migrations"
          }
        ]
      },
      "dependsOn": ["^build", "prisma-generate"]
    },
    "serve": {
      "continuous": true,
      "dependsOn": ["build"],
      "command": "node dist/apps/signflow-api/src/main.js",
      "options": {
        "env": {
          "DATABASE_URL": "postgresql://signflow:signflow-local@127.0.0.1:5432/signflow"
        }
      },
      "readyWhen": {
        "url": "http://localhost:3333/api/v1/health/live",
        "timeout": 120000
      },
      "configurations": {
        "e2e": {
          "env": {
            "DATABASE_URL": "postgresql://e2e:e2e-local@127.0.0.1:5433/signflow_e2e",
            "PORT": "4310"
          }
        }
      }
    },
    "prisma-migrate-dev": {
      "command": "prisma migrate dev",
      "options": {
        "cwd": "apps/signflow-api",
        "env": {
          "DATABASE_URL": "postgresql://signflow:signflow-local@127.0.0.1:5432/signflow"
        }
      },
      "cache": false
    },
    "prisma-migrate-deploy": {
      "command": "prisma migrate deploy",
      "options": {
        "cwd": "apps/signflow-api",
        "env": {
          "DATABASE_URL": "postgresql://signflow:signflow-local@127.0.0.1:5432/signflow"
        }
      },
      "cache": false
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "apps/signflow-api"
      },
      "cache": true,
      "inputs": ["default", "^production", "{projectRoot}/.env.example"],
      "dependsOn": ["^build", "build"]
    },
    "test-integration": {
      "command": "vitest run --config vitest.integration.config.mts",
      "options": {
        "cwd": "apps/signflow-api"
      },
      "cache": false,
      "dependsOn": ["^build", "prisma-generate"]
    },
    "typecheck": {
      "command": "tsc -p apps/signflow-api/tsconfig.spec.json --noEmit",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "dependsOn": ["^build", "prisma-generate"]
    },
    "openapi": {
      "command": "node dist/apps/signflow-api/src/openapi.js libs/signflow/api-contract/openapi.json",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/libs/signflow/api-contract/openapi.json"]
    },
    "api-check": {
      "command": "node dist/apps/signflow-api/src/openapi.js libs/signflow/api-contract/openapi.json --check",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/libs/signflow/api-contract/openapi.json"
      ]
    },
    "e2e-database": {
      "dependsOn": ["build"],
      "command": "node dist/apps/signflow-api/src/e2e-database.js",
      "options": {
        "env": {
          "DATABASE_URL": "postgresql://e2e:e2e-local@127.0.0.1:5433/signflow_e2e"
        }
      },
      "cache": false
    }
  }
}
