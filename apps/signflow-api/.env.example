# Settings of signflow-api (ADR-0009), with harmless example values.
# A test checks that this file lists exactly the settings of the schema
# (src/config/load-config.ts). Never put a real secret here.

# HTTP port of the API. Default 3333 (the same in every environment).
PORT=3333

# PostgreSQL connection (required, holds a password: no default). This value matches
# compose.dev.yaml, which runs a local database for development only.
DATABASE_URL=postgresql://signflow:signflow-local@127.0.0.1:5432/signflow

# Sessions (ADR-0010): end after this many days without activity, and at the latest this
# many days after sign-in. Defaults 7 and 30.
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Sign-in throttling (ADR-0010). An (e-mail, IP) pair waits 1, 2, 4 … minutes after
# LOGIN_PAIR_FREE_FAILURES failures, at most LOGIN_PAIR_MAX_LOCK_MINUTES; one IP waits after
# LOGIN_IP_MAX_FAILURES failures within LOGIN_IP_WINDOW_MINUTES; at most
# AUTH_RATE_LIMIT_PER_MINUTE sign-in requests per minute per IP.
LOGIN_PAIR_FREE_FAILURES=5
LOGIN_PAIR_MAX_LOCK_MINUTES=15
LOGIN_IP_MAX_FAILURES=50
LOGIN_IP_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20

# Argon2id hashes running at once (46 MiB of memory each); more wait in a queue.
ARGON2_MAX_CONCURRENT=4
