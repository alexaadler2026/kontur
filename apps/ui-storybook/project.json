{
  "name": "ui-storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "k",
  "sourceRoot": "apps/ui-storybook/src",
  "tags": ["scope:shared", "type:app"],
  "implicitDependencies": ["ui"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/ui-storybook",
        "browser": "apps/ui-storybook/src/main.ts",
        "tsConfig": "apps/ui-storybook/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ui-storybook/public"
          }
        ],
        "styles": [
          "libs/ui/src/styles/tokens.css",
          "libs/ui/src/styles/kontur-base.css",
          "apps/ui-storybook/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      },
      "options": {
        "port": 4400,
        "configDir": "apps/ui-storybook/.storybook",
        "browserTarget": "ui-storybook:build",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui-storybook",
        "configDir": "apps/ui-storybook/.storybook",
        "browserTarget": "ui-storybook:build",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "ui-storybook:build-storybook",
        "staticFilePath": "dist/storybook/ui-storybook",
        "spa": true,
        "port": 4402
      },
      "configurations": {
        "ci": {
          "buildTarget": "ui-storybook:build-storybook:ci"
        }
      }
    }
  }
}
