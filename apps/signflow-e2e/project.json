{
  "name": "signflow-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/signflow-e2e/src",
  "tags": ["scope:signflow", "type:e2e", "platform:server"],
  "implicitDependencies": ["signflow", "signflow-api"],
  "// targets": "to see all targets run: nx show project signflow-e2e --web",
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "projects": ["signflow", "signflow-api"],
          "target": "build"
        },
        {
          "projects": ["signflow-api"],
          "target": "e2e-database"
        }
      ]
    }
  }
}
